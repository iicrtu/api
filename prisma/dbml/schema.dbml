  "totalCount" int4 [not null, default: 0]
  "convertedCount" int4 [not null, default: 0]
  "failedCount" int4 [not null, default: 0]
  "skippedCount" int4 [not null, default: 0]
  "startedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
