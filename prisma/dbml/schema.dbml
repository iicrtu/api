Table "AlumniConversion" {
  "id" text [pk, not null]
  "batchId" text [not null]
  "userId" text [unique, not null]
  "status" AlumniConversionStatus [not null, default: 'PENDING']
  "error" text
  "convertedAt" timestamp
  "emailQueuedAt" timestamp
  "emailSentAt" timestamp
  "emailAttempts" int4 [not null, default: 0]

  Checks {
    `(status <> 'CONVERTED'::"AlumniConversionStatus") OR ("convertedAt" IS NOT NULL)` [name: 'alumni_conversion_converted_has_date']
  }

  Indexes {
    (batchId, userId) [type: btree, unique, name: "AlumniConversion_batchId_userId_key"]
    (batchId, status) [type: btree, name: "AlumniConversion_batchId_status_idx"]
    (emailQueuedAt, emailSentAt) [type: btree, name: "AlumniConversion_emailQueuedAt_emailSentAt_idx"]
  }
}

Table "Event" {
  "id" text [pk, not null]
  "slug" text [unique, not null, check: `(slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text) AND (char_length(slug) <= 120)`]
  "title" text [not null, check: `(char_length(btrim(title)) >= 1) AND (char_length(btrim(title)) <= 150)`]
  "summary" text [check: `(summary IS NULL) OR (char_length(summary) <= 200)`]
  "description" text [not null, check: `char_length(description) <= 20000`]
  "poster" text
  "galleryImages" "text[]" [default: `ARRAY[]::text[]`]
  "videoLinks" "text[]" [default: `ARRAY[]::text[]`]
  "mode" EventMode [not null]
  "venue" text
  "onlineLink" text [check: `("onlineLink" IS NULL) OR (("onlineLink" ~* '^https://[^[:space:]]+$'::text) AND (char_length("onlineLink") <= 500))`]
  "date" timestamp [not null]
  "eligibleYears" "int4[]" [check: `"eligibleYears" <@ ARRAY[1, 2, 3, 4, 5, 6]`, default: `ARRAY[]::integer[]`]
  "isRtuOnly" bool [not null, default: false]
  "participationType" ParticipationType [not null, default: 'INDIVIDUAL']
  "minTeamSize" int4
  "maxTeamSize" int4
  "registrationEnabled" bool [not null, default: false]
  "registrationOpensAt" timestamp
  "registrationClosesAt" timestamp
  "feeAmount" int4 [not null, default: 0]
  "status" EventStatus [not null, default: 'DRAFT']
  "publishedAt" timestamp
  "cancelledAt" timestamp
  "cancellationReason" text
  "createdById" text
  "hostPartnerId" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `("registrationOpensAt" IS NULL) OR ("registrationClosesAt" IS NULL) OR ("registrationOpensAt" < "registrationClosesAt")` [name: 'event_reg_window_chk']
    `(status <> 'PUBLISHED'::"EventStatus") OR ((poster IS NOT NULL) AND ("publishedAt" IS NOT NULL))` [name: 'event_published_chk']
    `(("participationType" = 'INDIVIDUAL'::"ParticipationType") AND ("minTeamSize" IS NULL) AND ("maxTeamSize" IS NULL)) OR (("participationType" = 'TEAM'::"ParticipationType") AND ("minTeamSize" >= 2) AND ("maxTeamSize" >= "minTeamSize") AND ("maxTeamSize" <= 10))` [name: 'event_team_chk']
    `("feeAmount" >= 0) AND (("feeAmount" = 0) OR "registrationEnabled")` [name: 'event_fee_chk']
    `(mode = 'ONLINE'::"EventMode") OR (venue IS NOT NULL)` [name: 'event_venue_chk']
    `(status <> 'CANCELLED'::"EventStatus") OR ("cancelledAt" IS NOT NULL)` [name: 'event_cancelled_chk']
    `(cardinality("galleryImages") <= 20) AND (cardinality("videoLinks") <= 10)` [name: 'event_media_caps_chk']
    `("registrationClosesAt" IS NULL) OR ("registrationClosesAt" <= date)` [name: 'event_reg_close_chk']
  }

  Indexes {
    hostPartnerId [type: btree, name: "Event_hostPartnerId_idx"]
    (status, date) [type: btree, name: "Event_status_date_idx"]
  }
}

Table "EventRegistration" {
  "id" text [pk, not null]
  "eventId" text [unique, not null]
  "teamName" text [check: `("teamName" IS NULL) OR (btrim("teamName") <> ''::text)`]
  "status" RegistrationStatus [not null, default: 'DRAFT']
  "feeAmount" int4 [not null, check: `"feeAmount" >= 0`, default: 0]
  "confirmedAt" timestamp
  "cancelledAt" timestamp
  "cancelReason" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(status <> 'CONFIRMED'::"RegistrationStatus") OR ("confirmedAt" IS NOT NULL)` [name: 'reg_confirmed_chk']
    `(status <> 'CANCELLED'::"RegistrationStatus") OR ("cancelledAt" IS NOT NULL)` [name: 'reg_cancelled_chk']
  }

  Indexes {
    (id, eventId) [type: btree, unique, name: "EventRegistration_id_eventId_key"]
    (eventId, status) [type: btree, name: "EventRegistration_eventId_status_idx"]
  }
}

Table "EventRegistrationMember" {
  "id" text [pk, not null]
  "registrationId" text [unique, not null]
  "eventId" text [not null]
  "studentId" text [not null]
  "isLeader" bool [not null, default: false]
  "joinedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "leftAt" timestamp
  "checkedInAt" timestamp

  Indexes {
    (eventId, studentId) [type: btree, unique, name: "member_one_live_per_event"]
    eventId [type: btree, name: "EventRegistrationMember_eventId_idx"]
    (registrationId, leftAt) [type: btree, name: "EventRegistrationMember_registrationId_leftAt_idx"]
    (studentId, joinedAt) [type: btree, name: "EventRegistrationMember_studentId_joinedAt_idx"]
  }
}

Table "EventTeamInvite" {
  "id" text [pk, not null]
  "registrationId" text [not null]
  "eventId" text [not null]
  "invitedStudentId" text [not null]
  "status" InviteStatus [not null, default: 'PENDING']
  "respondedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `((status = 'PENDING'::"InviteStatus") AND ("respondedAt" IS NULL)) OR ((status <> 'PENDING'::"InviteStatus") AND ("respondedAt" IS NOT NULL))` [name: 'invite_responded_chk']
  }

  Indexes {
    (registrationId, invitedStudentId) [type: btree, unique, name: "EventTeamInvite_registrationId_invitedStudentId_key"]
    (invitedStudentId, eventId, status) [type: btree, name: "EventTeamInvite_invitedStudentId_eventId_status_idx"]
    (registrationId, status) [type: btree, name: "EventTeamInvite_registrationId_status_idx"]
  }
}

Table "Payment" {
  "id" text [pk, not null]
  "registrationId" text [unique, not null]
  "amount" int4 [not null, check: `amount > 0`]
  "currency" text [not null, default: 'INR']
  "status" PaymentStatus [not null, default: 'CREATED']
  "gateway" text [not null, default: 'RAZORPAY']
  "gatewayOrderId" text [unique, not null]
  "gatewayPaymentId" text [unique]
  "method" text
  "failureReason" text
  "paidAt" timestamp
  "refundId" text [unique]
  "refundedAmount" int4 [not null, default: 0]
  "refundedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(status <> ALL (ARRAY['PAID'::"PaymentStatus", 'REFUND_PENDING'::"PaymentStatus", 'REFUNDED'::"PaymentStatus"])) OR (("paidAt" IS NOT NULL) AND ("gatewayPaymentId" IS NOT NULL))` [name: 'payment_paid_chk']
    `("refundedAmount" >= 0) AND ("refundedAmount" <= amount)` [name: 'payment_refund_chk']
  }

  Indexes {
    (registrationId, status) [type: btree, name: "Payment_registrationId_status_idx"]
    (status, createdAt) [type: btree, name: "Payment_status_createdAt_idx"]
  }
}

Table "PaymentWebhookEvent" {
  "id" text [pk, not null]
  "gateway" text [not null]
  "gatewayEventId" text [not null]
  "eventType" text [not null]
  "payload" jsonb [not null]
  "receivedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "processedAt" timestamp
  "error" text

  Indexes {
    (gateway, gatewayEventId) [type: btree, unique, name: "PaymentWebhookEvent_gateway_gatewayEventId_key"]
    processedAt [type: btree, name: "PaymentWebhookEvent_processedAt_idx"]
  }
}

Table "EventRegistrationStatusHistory" {
  "id" text [pk, not null]
  "registrationId" text [not null]
  "fromStatus" RegistrationStatus
  "toStatus" RegistrationStatus [not null]
  "actor" RegistrationActor [not null]
  "changedByUserId" text
  "reason" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (registrationId, createdAt) [type: btree, name: "EventRegistrationStatusHistory_registrationId_createdAt_idx"]
  }
}

Table "ExternalOpportunity" {
  "id" text [pk, not null]
  "title" text [not null, check: `(btrim(title) <> ''::text) AND (char_length(title) <= 150)`]
  "organizerName" text [not null, check: `(btrim("organizerName") <> ''::text) AND (char_length("organizerName") <= 100)`]
  "shortDescription" text [not null, check: `(btrim("shortDescription") <> ''::text) AND (char_length("shortDescription") <= 300)`]
  "applyLink" text [unique, not null, check: `("applyLink" ~* '^https://[^[:space:]]+$'::text) AND (char_length("applyLink") <= 500)`]
  "type" ExternalOpportunityType [not null]
  "mode" WorkMode [not null]
  "location" text
  "eligibleYears" "int4[]" [check: `"eligibleYears" <@ ARRAY[1, 2, 3, 4, 5, 6]`, default: `ARRAY[]::integer[]`]
  "deadline" timestamp
  "startsAt" timestamp
  "status" ExternalOpportunityStatus [not null, default: 'DRAFT']
  "isFeatured" bool [not null, default: false]
  "clickCount" int4 [not null, check: `"clickCount" >= 0`, default: 0]
  "publishedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `((mode = 'REMOTE'::"WorkMode") OR ((location IS NOT NULL) AND (btrim(location) <> ''::text))) AND ((location IS NULL) OR (char_length(location) <= 100))` [name: 'extopp_location_chk']
    `(status <> 'PUBLISHED'::"ExternalOpportunityStatus") OR ("publishedAt" IS NOT NULL)` [name: 'extopp_published_chk']
  }

  Indexes {
    (status, deadline) [type: btree, name: "ExternalOpportunity_status_deadline_idx"]
    (status, type) [type: btree, name: "ExternalOpportunity_status_type_idx"]
  }
}

Table "Innovation" {
  "id" text [pk, not null]
  "slug" text [unique, not null, check: `(slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text) AND (char_length(slug) <= 120)`]
  "title" text [not null, check: `(char_length(btrim(title)) >= 1) AND (char_length(btrim(title)) <= 150)`]
  "shortDescription" text [not null, check: `(char_length(btrim("shortDescription")) >= 1) AND (char_length(btrim("shortDescription")) <= 200)`]
  "thumbnail" text [check: `(thumbnail IS NULL) OR ((char_length(btrim(thumbnail)) >= 1) AND (char_length(btrim(thumbnail)) <= 300))`]
  "hasDetailPage" bool [not null, default: false]
  "description" text [check: `(description IS NULL) OR (char_length(description) <= 20000)`]
  "galleryImages" "text[]" [default: `ARRAY[]::text[]`]
  "videoLinks" "text[]" [default: `ARRAY[]::text[]`]
  "members" "text[]" [default: `ARRAY[]::text[]`]
  "year" int4 [not null, check: `(year >= 2000) AND (year <= 2100)`]
  "demoUrl" text [check: `("demoUrl" IS NULL) OR (("demoUrl" ~* '^https://[^[:space:]]+$'::text) AND (char_length("demoUrl") <= 500))`]
  "patentStatus" PatentStatus [not null, default: 'NONE']
  "displayOrder" int4 [not null, check: `"displayOrder" >= 0`, default: 0]
  "isFeatured" bool [not null, default: false]
  "status" InitiativeStatus [not null, default: 'DRAFT']
  "publishedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(NOT "hasDetailPage") OR ((description IS NOT NULL) AND (char_length(btrim(description)) > 0))` [name: 'Innovation_detailpage_needs_description_chk']
    `(status <> 'PUBLISHED'::"InitiativeStatus") OR (("publishedAt" IS NOT NULL) AND (thumbnail IS NOT NULL) AND (cardinality(members) >= 1))` [name: 'Innovation_published_complete_chk']
  }

  Indexes {
    (status, displayOrder) [type: btree, name: "Innovation_status_displayOrder_idx"]
    (status, isFeatured) [type: btree, name: "Innovation_status_isFeatured_idx"]
  }
}

Table "Incubation" {
  "id" text [pk, not null]
  "title" text [unique, not null, check: `(char_length(btrim(title)) >= 1) AND (char_length(btrim(title)) <= 150)`]
  "shortDescription" text [not null, check: `(char_length(btrim("shortDescription")) >= 1) AND (char_length(btrim("shortDescription")) <= 200)`]
  "logo" text [check: `(logo IS NULL) OR ((char_length(btrim(logo)) >= 1) AND (char_length(btrim(logo)) <= 300))`]
  "website" text [check: `(website IS NULL) OR ((website ~* '^https://[^[:space:]]+$'::text) AND (char_length(website) <= 500))`]
  "founders" "text[]" [default: `ARRAY[]::text[]`]
  "incubatedYear" int4 [not null, check: `("incubatedYear" >= 2000) AND ("incubatedYear" <= 2100)`]
  "sector" Industry [not null]
  "displayOrder" int4 [not null, check: `"displayOrder" >= 0`, default: 0]
  "isFeatured" bool [not null, default: false]
  "status" InitiativeStatus [not null, default: 'DRAFT']
  "publishedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(status <> 'PUBLISHED'::"InitiativeStatus") OR (("publishedAt" IS NOT NULL) AND (logo IS NOT NULL) AND (cardinality(founders) >= 1))` [name: 'Incubation_published_complete_chk']
  }

  Indexes {
    (status, displayOrder) [type: btree, name: "Incubation_status_displayOrder_idx"]
    (status, isFeatured) [type: btree, name: "Incubation_status_isFeatured_idx"]
  }
}

Ref "AlumniConversion_batchId_fkey":"AlumniConversionBatch"."id" <? "AlumniConversion"."batchId" [update: cascade, delete: restrict]

