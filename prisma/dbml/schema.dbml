Table "_prisma_migrations" {
  "id" varchar(36) [pk, not null]
  "checksum" varchar(64) [not null]
  "finished_at" timestamptz
  "migration_name" varchar(255) [not null]
  "logs" text
  "rolled_back_at" timestamptz
  "started_at" timestamptz [not null, default: `now()`]
  "applied_steps_count" int4 [not null, default: 0]
}

Table "User" {
  "id" text [pk, not null]
  "name" text [not null]
  "email" text [unique, not null, check: `email = lower(btrim(email))`]
  "emailVerifiedAt" timestamp
  "password" text
  "passwordChangedAt" timestamp
  "googleId" text [unique]
  "role" UserRole [unique, not null]
  "status" AccountStatus [not null, default: 'PENDING_EMAIL_VERIFICATION']
  "lastLoginAt" timestamp
  "deletedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `("deletedAt" IS NOT NULL) OR (password IS NOT NULL) OR ("googleId" IS NOT NULL)` [name: 'user_has_login_method']
    `(status <> 'ACTIVE'::"AccountStatus") OR ("emailVerifiedAt" IS NOT NULL)` [name: 'user_active_requires_verified_email']
  }

  Indexes {
    role [type: btree, name: "User_role_idx"]
    status [type: btree, name: "User_status_idx"]
  }
}

Table "Session" {
  "id" text [pk, not null]
  "userId" text [not null]
  "refreshTokenHash" text [unique, not null]
  "prevRefreshTokenHash" text [unique]
  "rotatedAt" timestamp
  "revokedAt" timestamp
  "revokedReason" SessionRevokeReason
  "lastUsedAt" timestamp
  "expiresAt" timestamp [not null]
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "ipAddress" text
  "userAgent" text

  Indexes {
    expiresAt [type: btree, name: "Session_expiresAt_idx"]
    userId [type: btree, name: "Session_userId_idx"]
  }
}

Table "AuthToken" {
  "id" text [pk, not null]
  "userId" text [not null]
  "tokenHash" text [unique, not null]
  "type" AuthTokenType [not null]
  "expiresAt" timestamp [not null]
  "usedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    expiresAt [type: btree, name: "AuthToken_expiresAt_idx"]
    (userId, type) [type: btree, name: "AuthToken_userId_type_idx"]
  }
}

Table "StatusHistory" {
  "id" text [pk, not null]
  "userId" text [not null]
  "fromStatus" AccountStatus
  "toStatus" AccountStatus [not null]
  "changedBy" StatusChangedBy [not null]
  "changedById" text
  "reason" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (userId, createdAt) [type: btree, name: "StatusHistory_userId_createdAt_idx"]
  }
}

Table "Student" {
  "id" text [pk, not null]
  "userId" text [unique, not null]
  "fullName" text
  "profileImage" text
  "location" text [check: `(location IS NULL) OR (char_length(location) <= 150)`]
  "isRTUStudent" bool
  "collegeCode" text
  "collegeName" text
  "course" Degree
  "branch" Branch
  "graduationYear" int4 [check: `("graduationYear" IS NULL) OR (("graduationYear" >= 2000) AND ("graduationYear" <= 2100))`]
  "crNo" text [check: `("crNo" IS NULL) OR ("crNo" = upper(btrim("crNo")))`, check: `("crNo" IS NULL) OR (btrim("crNo") <> ''::text)`]
  "rollNo" text [check: `("rollNo" IS NULL) OR (btrim("rollNo") <> ''::text)`, check: `("rollNo" IS NULL) OR ("rollNo" = upper(btrim("rollNo")))`]
  "phone" text [check: `(phone IS NULL) OR (phone ~ '^\+[1-9][0-9]{7,14}$'::text)`]
  "alternatePhone" text [check: `("alternatePhone" IS NULL) OR ("alternatePhone" ~ '^\+[1-9][0-9]{7,14}$'::text)`]
  "alternateEmail" text [check: `("alternateEmail" IS NULL) OR ("alternateEmail" = lower(btrim("alternateEmail")))`]
  "isOnboardingComplete" bool [not null, default: false]
  "isActive" bool [not null, default: true]
  "alumniConvertedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(branch IS NULL) OR (COALESCE("isRTUStudent", false) AND (NOT (course IS DISTINCT FROM 'BTECH_BE'::"Degree")))` [name: 'student_branch_only_rtu_btech']
    `("rollNo" IS NULL) OR (NOT COALESCE("isRTUStudent", false)) OR ("rollNo" ~~ '%UC%'::text)` [name: 'student_rtu_rollno_has_uc']
    `(NOT COALESCE("isRTUStudent", false)) OR ("collegeCode" IS NOT NULL)` [name: 'student_rtu_has_college_code']
    `(NOT "isOnboardingComplete") OR (("fullName" IS NOT NULL) AND ("isRTUStudent" IS NOT NULL) AND ("collegeName" IS NOT NULL) AND (course IS NOT NULL) AND ("graduationYear" IS NOT NULL) AND (phone IS NOT NULL) AND ((NOT (COALESCE("isRTUStudent", false) AND (NOT (course IS DISTINCT FROM 'BTECH_BE'::"Degree")))) OR (branch IS NOT NULL)))` [name: 'student_onboarding_requires_fields']
  }

  Indexes {
    (collegeCode, crNo) [type: btree, unique, name: "Student_collegeCode_crNo_key"]
    (collegeCode, rollNo) [type: btree, unique, name: "Student_collegeCode_rollNo_key"]
    (collegeCode, graduationYear) [type: btree, name: "Student_collegeCode_graduationYear_idx"]
  }
}

Table "Resume" {
  "id" text [pk, not null]
  "studentId" text [unique, not null]
  "name" text [not null]
  "fileKey" text [not null]
  "isPrimary" bool [not null, default: false]
  "deletedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (id, studentId) [type: btree, unique, name: "Resume_id_studentId_key"]
    studentId [type: btree, name: "Resume_studentId_idx"]
  }
}

Table "SocialLink" {
  "id" text [pk, not null]
  "platform" SocialPlatform [not null]
  "url" text [not null, check: `url ~* '^https://'::text`]
  "customName" text
  "studentId" text
  "orgId" text
  "partnerId" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `num_nonnulls("studentId", "orgId", "partnerId") = 1` [name: 'social_exactly_one_owner']
    `(platform = 'OTHER'::"SocialPlatform") = ("customName" IS NOT NULL)` [name: 'social_custom_name_only_other']
  }

  Indexes {
    (orgId, platform) [type: btree, unique, name: "social_org_platform_unique"]
    (partnerId, platform) [type: btree, unique, name: "social_partner_platform_unique"]
    (studentId, platform) [type: btree, unique, name: "social_student_platform_unique"]
    orgId [type: btree, name: "SocialLink_orgId_idx"]
    partnerId [type: btree, name: "SocialLink_partnerId_idx"]
    studentId [type: btree, name: "SocialLink_studentId_idx"]
  }
}

Table "VerificationHistory" {
  "id" text [pk, not null]
  "organizationId" text
  "partnerId" text
  "fromStatus" VerificationStatus
  "toStatus" VerificationStatus [not null]
  "reviewedById" text
  "reason" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `num_nonnulls("organizationId", "partnerId") = 1` [name: 'verification_history_one_owner']
  }

  Indexes {
    (organizationId, createdAt) [type: btree, name: "VerificationHistory_organizationId_createdAt_idx"]
    (partnerId, createdAt) [type: btree, name: "VerificationHistory_partnerId_createdAt_idx"]
  }
}

Table "ProfileChangeRequest" {
  "id" text [pk, not null]
  "organizationId" text [unique]
  "partnerId" text [unique]
  "changes" jsonb [not null, check: `jsonb_typeof(changes) = 'object'::text`]
  "status" ChangeRequestStatus [not null, default: 'PENDING']
  "reviewedById" text
  "reviewedAt" timestamp
  "reason" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `num_nonnulls("organizationId", "partnerId") = 1` [name: 'change_request_one_owner']
  }

  Indexes {
    (organizationId, status) [type: btree, name: "ProfileChangeRequest_organizationId_status_idx"]
    (partnerId, status) [type: btree, name: "ProfileChangeRequest_partnerId_status_idx"]
    (status, createdAt) [type: btree, name: "ProfileChangeRequest_status_createdAt_idx"]
  }
}

Table "Organization" {
  "id" text [pk, not null]
  "userId" text [unique, not null]
  "verificationStatus" VerificationStatus [not null, default: 'DRAFT']
  "submissionCount" int4 [not null, default: 0]
  "submittedAt" timestamp
  "approvedAt" timestamp
  "name" text
  "logo" text
  "banner" text
  "location" text
  "website" text [check: `(website IS NULL) OR (website ~* '^https://'::text)`]
  "phone" text [check: `(phone IS NULL) OR (phone ~ '^\+[1-9][0-9]{7,14}$'::text)`]
  "alternatePhone" text [check: `("alternatePhone" IS NULL) OR ("alternatePhone" ~ '^\+[1-9][0-9]{7,14}$'::text)`]
  "alternateEmail" text [check: `("alternateEmail" IS NULL) OR ("alternateEmail" = lower(btrim("alternateEmail")))`]
  "contactPersonName" text
  "contactPersonDesignation" text
  "contactIdKey" text
  "tagline" text
  "about" text
  "foundingYear" int4 [check: `("foundingYear" IS NULL) OR (("foundingYear" >= 1800) AND ("foundingYear" <= 2100))`]
  "size" OrgSize
  "industry" Industry
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `("verificationStatus" <> 'APPROVED'::"VerificationStatus") OR ("approvedAt" IS NOT NULL)` [name: 'org_approved_has_date']
    `(char_length(name) <= 120) AND (char_length(tagline) <= 150) AND (char_length(about) <= 3000) AND (char_length(location) <= 150) AND (char_length("contactPersonName") <= 120) AND (char_length("contactPersonDesignation") <= 100)` [name: 'org_text_lengths']
    `("verificationStatus" = ANY (ARRAY['DRAFT'::"VerificationStatus", 'REJECTED'::"VerificationStatus"])) OR ((name IS NOT NULL) AND (location IS NOT NULL) AND (website IS NOT NULL) AND (phone IS NOT NULL) AND (about IS NOT NULL) AND ("foundingYear" IS NOT NULL) AND (size IS NOT NULL) AND (industry IS NOT NULL) AND ("contactPersonName" IS NOT NULL) AND ("contactPersonDesignation" IS NOT NULL))` [name: 'org_submitted_requires_fields']
    `("verificationStatus" <> 'SUBMITTED'::"VerificationStatus") OR ("contactIdKey" IS NOT NULL)` [name: 'org_submitted_has_id']
  }

  Indexes {
    verificationStatus [type: btree, name: "Organization_verificationStatus_idx"]
  }
}

Table "Job" {
  "id" text [pk, not null]
  "organizationId" text [not null]
  "title" text [not null]
  "description" text [not null]
  "location" text
  "workMode" WorkMode [not null]
  "jobType" JobType [not null]
  "salary" int4 [check: `(salary IS NULL) OR (salary >= 0)`]
  "isSalaryDisclosed" bool [not null, default: true]
  "isRtuOnly" bool [not null, default: false]
  "minGraduationYear" int4
  "maxGraduationYear" int4
  "openings" int4 [not null, check: `(openings >= 1) AND (openings <= 1000)`, default: 1]
  "durationMonths" int4
  "deadline" timestamp
  "status" JobStatus [not null, default: 'DRAFT']
  "publishedAt" timestamp
  "closedAt" timestamp
  "removedAt" timestamp
  "removedById" text
  "removalReason" text
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `("workMode" = 'REMOTE'::"WorkMode") OR (location IS NOT NULL)` [name: 'job_location_unless_remote']
    `(status <> ALL (ARRAY['PUBLISHED'::"JobStatus", 'PAUSED'::"JobStatus"])) OR ("publishedAt" IS NOT NULL)` [name: 'job_published_has_date']
    `(status <> 'REMOVED'::"JobStatus") OR (("removedAt" IS NOT NULL) AND ("removalReason" IS NOT NULL))` [name: 'job_removed_has_audit']
    `(("minGraduationYear" IS NULL) OR (("minGraduationYear" >= 2000) AND ("minGraduationYear" <= 2100))) AND (("maxGraduationYear" IS NULL) OR (("maxGraduationYear" >= 2000) AND ("maxGraduationYear" <= 2100))) AND (("minGraduationYear" IS NULL) OR ("maxGraduationYear" IS NULL) OR ("minGraduationYear" <= "maxGraduationYear"))` [name: 'job_graduation_year_rules']
    `(("jobType" <> 'INTERNSHIP'::"JobType") OR ("durationMonths" IS NOT NULL)) AND (("durationMonths" IS NULL) OR (("durationMonths" >= 1) AND ("durationMonths" <= 36)))` [name: 'job_duration_rules']
    `(char_length(title) <= 150) AND (char_length(description) <= 10000)` [name: 'job_text_lengths']
  }

  Indexes {
    (id, organizationId) [type: btree, unique, name: "Job_id_organizationId_key"]
    deadline [type: btree, name: "Job_deadline_idx"]
    (organizationId, status) [type: btree, name: "Job_organizationId_status_idx"]
    (status, publishedAt) [type: btree, name: "Job_status_publishedAt_idx"]
  }
}

Table "Application" {
  "id" text [pk, not null]
  "studentId" text [not null]
  "jobId" text [not null]
  "organizationId" text [not null]
  "resumeId" text [not null]
  "status" ApplicationStatus [not null, default: 'SUBMITTED']
  "internalNote" text [check: `char_length("internalNote") <= 2000`]
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Indexes {
    (studentId, jobId) [type: btree, unique, name: "Application_studentId_jobId_key"]
    (jobId, status) [type: btree, name: "Application_jobId_status_idx"]
    (organizationId, status) [type: btree, name: "Application_organizationId_status_idx"]
    resumeId [type: btree, name: "Application_resumeId_idx"]
    (studentId, createdAt) [type: btree, name: "Application_studentId_createdAt_idx"]
  }
}

Table "ApplicationStatusHistory" {
  "id" text [pk, not null]
  "applicationId" text [not null]
  "fromStatus" ApplicationStatus
  "toStatus" ApplicationStatus [not null]
  "actor" ApplicationActor [not null]
  "changedByUserId" text
  "studentRemark" text [check: `char_length("studentRemark") <= 1000`]
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (applicationId, createdAt) [type: btree, name: "ApplicationStatusHistory_applicationId_createdAt_idx"]
  }
}

Table "Partner" {
  "id" text [pk, not null]
  "userId" text [unique, not null]
  "partnerType" PartnerType [not null]
  "verificationStatus" VerificationStatus [not null, default: 'DRAFT']
  "submissionCount" int4 [not null, default: 0]
  "submittedAt" timestamp
  "approvedAt" timestamp
  "convertedAt" timestamp
  "name" text
  "image" text
  "banner" text
  "location" text
  "website" text
  "tagline" text
  "about" text
  "phone" text
  "alternatePhone" text
  "alternateEmail" text
  "mentorContactEmail" text
  "contactPersonName" text
  "contactPersonDesignation" text
  "contactIdKey" text
  "foundingYear" int4
  "collegeCode" text
  "collegeName" text
  "course" Degree
  "graduationYear" int4
  "currentRole" text
  "yearsOfExperience" int4
  "expertise" "text[]" [default: `ARRAY[]::text[]`]
  "industry" Industry
  "isListed" bool [not null, default: false]
  "isAcceptingRequests" bool [not null, default: false]
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(("partnerType" = ANY (ARRAY['ECELL'::"PartnerType", 'COLLEGE'::"PartnerType"])) OR (("contactPersonName" IS NULL) AND ("contactPersonDesignation" IS NULL) AND ("contactIdKey" IS NULL) AND ("foundingYear" IS NULL))) AND (("partnerType" = ANY (ARRAY['ECELL'::"PartnerType", 'COLLEGE'::"PartnerType", 'ALUMNI'::"PartnerType"])) OR (("collegeCode" IS NULL) AND ("collegeName" IS NULL))) AND (("partnerType" = 'ALUMNI'::"PartnerType") OR ((course IS NULL) AND ("graduationYear" IS NULL))) AND (("partnerType" = ANY (ARRAY['MENTOR_SPEAKER'::"PartnerType", 'ALUMNI'::"PartnerType"])) OR (("mentorContactEmail" IS NULL) AND ("currentRole" IS NULL) AND ("yearsOfExperience" IS NULL) AND (industry IS NULL) AND ("mentorContactEmail" IS NULL) AND (COALESCE(cardinality(expertise), 0) = 0)))` [name: 'partner_type_specific_fields']
    `("verificationStatus" = ANY (ARRAY['DRAFT'::"VerificationStatus", 'REJECTED'::"VerificationStatus"])) OR ("convertedAt" IS NOT NULL) OR ((name IS NOT NULL) AND (location IS NOT NULL) AND (about IS NOT NULL) AND (phone IS NOT NULL) AND (("partnerType" <> ALL (ARRAY['ECELL'::"PartnerType", 'COLLEGE'::"PartnerType"])) OR (("collegeCode" IS NOT NULL) AND ("collegeName" IS NOT NULL) AND ("contactPersonName" IS NOT NULL) AND ("contactPersonDesignation" IS NOT NULL))) AND (("partnerType" <> 'ALUMNI'::"PartnerType") OR (("collegeCode" IS NOT NULL) AND ("collegeName" IS NOT NULL) AND (course IS NOT NULL) AND ("graduationYear" IS NOT NULL) AND ("mentorContactEmail" IS NOT NULL))) AND (("partnerType" <> 'MENTOR_SPEAKER'::"PartnerType") OR (("currentRole" IS NOT NULL) AND ("mentorContactEmail" IS NOT NULL) AND (COALESCE(cardinality(expertise), 0) > 0))))` [name: 'partner_submitted_requires_fields']
    `("convertedAt" IS NULL) OR (("partnerType" = 'ALUMNI'::"PartnerType") AND ("verificationStatus" = 'APPROVED'::"VerificationStatus") AND ("approvedAt" IS NOT NULL) AND (name IS NOT NULL) AND ("collegeName" IS NOT NULL) AND (course IS NOT NULL) AND ("graduationYear" IS NOT NULL) AND (phone IS NOT NULL))` [name: 'partner_converted_rules']
    `("verificationStatus" <> 'APPROVED'::"VerificationStatus") OR ("partnerType" <> ALL (ARRAY['MENTOR_SPEAKER'::"PartnerType", 'ALUMNI'::"PartnerType"])) OR (NOT ("isListed" OR "isAcceptingRequests")) OR (("currentRole" IS NOT NULL) AND (COALESCE(cardinality(expertise), 0) > 0) AND ("mentorContactEmail" IS NOT NULL))` [name: 'partner_public_mentor_needs_fields']
    `("verificationStatus" <> 'APPROVED'::"VerificationStatus") OR ("approvedAt" IS NOT NULL)` [name: 'partner_approved_has_date']
    `("verificationStatus" <> 'SUBMITTED'::"VerificationStatus") OR ("partnerType" <> ALL (ARRAY['ECELL'::"PartnerType", 'COLLEGE'::"PartnerType"])) OR ("contactIdKey" IS NOT NULL)` [name: 'partner_submitted_entity_has_id']
    `((website IS NULL) OR (website ~* '^https://'::text)) AND ((phone IS NULL) OR (phone ~ '^\+[1-9][0-9]{7,14}$'::text)) AND (("alternatePhone" IS NULL) OR ("alternatePhone" ~ '^\+[1-9][0-9]{7,14}$'::text)) AND (("alternateEmail" IS NULL) OR ("alternateEmail" = lower(btrim("alternateEmail")))) AND (("mentorContactEmail" IS NULL) OR ("mentorContactEmail" = lower(btrim("mentorContactEmail")))) AND (("foundingYear" IS NULL) OR (("foundingYear" >= 1800) AND ("foundingYear" <= 2100))) AND (("graduationYear" IS NULL) OR (("graduationYear" >= 2000) AND ("graduationYear" <= 2100))) AND (("yearsOfExperience" IS NULL) OR (("yearsOfExperience" >= 0) AND ("yearsOfExperience" <= 60)))` [name: 'partner_formats']
    `(char_length(name) <= 120) AND (char_length(tagline) <= 150) AND (char_length(about) <= 3000) AND (char_length(location) <= 150) AND (char_length("currentRole") <= 150) AND (char_length("contactPersonName") <= 120) AND (char_length("contactPersonDesignation") <= 100) AND (COALESCE(cardinality(expertise), 0) <= 10) AND (max_text_len(expertise) <= 40)` [name: 'partner_text_lengths']
  }

  Indexes {
    (id, partnerType) [type: btree, unique, name: "Partner_id_partnerType_key"]
    (partnerType, collegeCode) [type: btree, unique, name: "partner_one_approved_entity_per_college"]
    collegeCode [type: btree, name: "Partner_collegeCode_idx"]
    (partnerType, verificationStatus) [type: btree, name: "Partner_partnerType_verificationStatus_idx"]
    verificationStatus [type: btree, name: "Partner_verificationStatus_idx"]
  }
}

Table "Startup" {
  "id" text [pk, not null]
  "partnerId" text [not null]
  "partnerType" PartnerType [not null, check: `"partnerType" = 'ENTREPRENEUR'::"PartnerType"`, default: 'ENTREPRENEUR']
  "name" text [not null]
  "description" text
  "logo" text
  "website" text
  "stage" StartupStage [not null]
  "industry" Industry [not null]
  "foundingYear" int4
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `((website IS NULL) OR (website ~* '^https://'::text)) AND (("foundingYear" IS NULL) OR (("foundingYear" >= 1800) AND ("foundingYear" <= 2100))) AND (char_length(name) <= 120) AND (char_length(description) <= 2000)` [name: 'startup_rules']
  }

  Indexes {
    (partnerId, name) [type: btree, unique, name: "Startup_partnerId_name_key"]
    partnerId [type: btree, name: "Startup_partnerId_idx"]
  }
}

Table "MentorshipRequest" {
  "id" text [pk, not null]
  "studentId" text
  "requesterAlumniId" text
  "requesterAlumniType" PartnerType
  "mentorId" text [not null]
  "mentorType" PartnerType [not null, check: `"mentorType" = ANY (ARRAY['MENTOR_SPEAKER'::"PartnerType", 'ALUMNI'::"PartnerType"])`]
  "message" text [not null]
  "status" MentorshipStatus [not null, default: 'PENDING']
  "responseNote" text
  "sharePhone" bool [not null, default: false]
  "respondedAt" timestamp
  "expiresAt" timestamp [not null]
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(num_nonnulls("studentId", "requesterAlumniId") = 1) AND (("requesterAlumniId" IS NULL) = ("requesterAlumniType" IS NULL)) AND (("requesterAlumniType" IS NULL) OR ("requesterAlumniType" = 'ALUMNI'::"PartnerType")) AND (("requesterAlumniId" IS NULL) OR ("requesterAlumniId" <> "mentorId"))` [name: 'mentorship_one_requester']
    `(NOT "sharePhone") OR (status = 'ACCEPTED'::"MentorshipStatus")` [name: 'mentorship_phone_only_when_accepted']
    `(char_length(message) <= 1000) AND (char_length("responseNote") <= 500)` [name: 'mentorship_text_lengths']
    `(status <> ALL (ARRAY['ACCEPTED'::"MentorshipStatus", 'DECLINED'::"MentorshipStatus"])) OR ("respondedAt" IS NOT NULL)` [name: 'mentorship_response_has_date']
  }

  Indexes {
    (studentId, mentorId) [type: btree, unique, name: "mentorship_one_pending"]
    (requesterAlumniId, mentorId) [type: btree, unique, name: "mentorship_one_pending_alumni"]
    (mentorId, status, createdAt) [type: btree, name: "MentorshipRequest_mentorId_status_createdAt_idx"]
    (requesterAlumniId, createdAt) [type: btree, name: "MentorshipRequest_requesterAlumniId_createdAt_idx"]
    (requesterAlumniId, mentorId, createdAt) [type: btree, name: "MentorshipRequest_requesterAlumniId_mentorId_createdAt_idx"]
    (studentId, createdAt) [type: btree, name: "MentorshipRequest_studentId_createdAt_idx"]
    (studentId, mentorId, createdAt) [type: btree, name: "MentorshipRequest_studentId_mentorId_createdAt_idx"]
  }
}

Table "CollaborationRequest" {
  "id" text [pk, not null]
  "partnerId" text [not null]
  "direction" CollaborationDirection [not null]
  "type" CollaborationType [not null]
  "title" text [not null]
  "description" text [not null]
  "proposedDate" timestamp
  "status" CollaborationStatus [not null, default: 'PENDING']
  "responseNote" text
  "respondedById" text
  "respondedAt" timestamp
  "createdAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updatedAt" timestamp [not null]

  Checks {
    `(char_length(title) <= 150) AND (char_length(description) <= 3000) AND (char_length("responseNote") <= 1000)` [name: 'collaboration_text_lengths']
    `(status <> ALL (ARRAY['ACCEPTED'::"CollaborationStatus", 'DECLINED'::"CollaborationStatus"])) OR ("respondedAt" IS NOT NULL)` [name: 'collaboration_response_has_date']
  }

  Indexes {
    (partnerId, createdAt) [type: btree, name: "CollaborationRequest_partnerId_createdAt_idx"]
    (status, createdAt) [type: btree, name: "CollaborationRequest_status_createdAt_idx"]
  }
}

Table "AlumniConversionBatch" {
